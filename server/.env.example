PORT=3001
JWT_SECRET=change-this-secret-in-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chatters
POSTGRES_PASSWORD=chatters
POSTGRES_DB=chatters
# POSTGRES_POOL_MAX=20
# POSTGRES_SSL=true
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
# Reverse-proxy addresses to trust for the real client IP (rate limiting keys on it).
# Defaults to loopback + private ranges. Do not set to `true`: that lets any client
# forge X-Forwarded-For and bypass the rate limiter entirely.
# TRUST_PROXY=127.0.0.1
